# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Emulators (for local development)
VITE_USE_FIREBASE_EMULATORS=false

# Application Configuration
VITE_APP_NAME=IPDC Digital Platform
VITE_APP_VERSION=1.0.0

# Email Service (for notifications)
# Using EmailJS (free tier) - get API keys from https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_ADMIN_EMAIL=admin@ipdc.gov.et
VITE_SUPPORT_EMAIL=support@ipdc.gov.et
VITE_NOTIFICATIONS_FROM_EMAIL=noreply@ipdc.gov.et

# API Configuration
VITE_API_BASE_URL=https://api.ipdc.gov.et
VITE_AI_API_URL=https://ipdc-oss-platform.onrender.com

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true

# Token System Configuration
VITE_DEFAULT_TOKEN_BALANCE=1000
VITE_TOKEN_EXPIRY_DAYS=365
